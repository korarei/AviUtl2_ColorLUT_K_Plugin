#include <winres.h>

#include "resource.h"

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT
#pragma code_page(65001)

IDD_EXPORT_DIALOG DIALOGEX 0, 0, 200, 50
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Export Settings"
FONT 9, "MS Shell Dlg 2", 400, 0, 1
BEGIN
    LTEXT "TITLE:", IDC_STATIC, 7, 10, 28, 8
    EDITTEXT IDC_EXPORT_TITLE_EDIT, 38, 8, 155, 14, ES_AUTOHSCROLL | ES_LEFT | WS_BORDER | WS_TABSTOP
    PUSHBUTTON "OK", IDOK, 143, 32, 50, 12
END
